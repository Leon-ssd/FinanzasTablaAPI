# ~/Documentos/Finanzas/.env.example

# Configuración de PostgreSQL
POSTGRES_DB=finanzas_db
POSTGRES_USER=usuario_ejemplo
POSTGRES_PASSWORD=cambiar_esta_contrasena

# Configuración del Backend
API_HOST_PORT=5000
API_CONTAINER_PORT=8080
CONNECTION_STRING=Host=db;Port=5432;Database=finanzas_db;Username=usuario_ejemplo;Password=cambiar_esta_contrasena